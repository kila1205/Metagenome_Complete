/*
 * Profil Slurm untuk pipeline metagenome - QoS normal.
 *
 *   nextflow run main.nf -profile slurm ...
 *
 * Batas QoS normal di cluster ini:
 *   GrpTRES        cpu=32, mem=64G   <- TOTAL untuk seluruh QoS, bukan per orang
 *   MaxTRESPerUser cpu=64, mem=250G
 *
 * Karena GrpTRES membatasi total 64 GB, permintaan di atas itu dipangkas
 * otomatis lewat resourceLimits - bukan ditolak Slurm.
 * queueSize 2: job kedua otomatis antre bila node penuh.
 */

profiles {

    slurm {
        process {
            executor       = 'slurm'
            queue          = 'long'
            clusterOptions = '--qos=besar --requeue'
            // Siapkan Conda bersama di node komputasi.
            // Tanpa ini, 'conda info' pada skrip Nextflow tidak menemukan apa pun
            // dan aktivasi environment gagal dengan '/bin/activate not found'.
            // Bersihkan variabel CONDA_* warisan dari node submit, lalu taruh
            // binari conda di PATH. Lebih andal daripada source conda.sh,
            // yang berperilaku lain bila CONDA_SHLVL sudah terisi.
            // HOME diwariskan dari node submit dan bisa tidak ada di node komputasi
            // (home user berbeda antar-node). Conda gagal total tanpa HOME yang valid,
            // jadi HOME ditentukan ulang dari /etc/passwd node yang menjalankan.
            beforeScript   = 'export HOME=$(getent passwd "$(id -un)" | cut -d: -f6); unset CONDA_SHLVL CONDA_PREFIX CONDA_DEFAULT_ENV CONDA_EXE CONDA_PYTHON_EXE _CE_CONDA _CE_M; export PATH=/media/bio-pool/software/miniforge3/bin:$PATH'
            scratch        = '/mnt/scratch'
            stageInMode    = 'symlink'
            // stageOutMode dibiarkan bawaan Nextflow (copy).
            // 'move' berisiko saat dipakai bersama scratch: berkas keluaran bisa
            // hilang di tengah proses pemindahan.

            // Pangkas permintaan yang melebihi plafon QoS normal.
            // GTDBTK_CLASSIFY minta 96 GB -> otomatis jadi 60 GB.
            resourceLimits = [ cpus: 96, memory: 376.GB, time: 5.d ]

            errorStrategy = {
                // Ulangi kegagalan yang sifatnya sementara, maksimal 3 percobaan.
                //
                // Exit 1 SENGAJA ikut diulang: kalau node jatuh atau reboot,
                // Slurm melaporkan NODE_FAIL sebagai exit 1. Tanpa ini, satu
                // reboot node membunuh seluruh pipeline - itu yang terjadi
                // pada 25 Sep 2026 pukul 00:20 WIB.
                //
                // Konsekuensinya: skrip yang memang salah juga akan dicoba
                // 3 kali sebelum berhenti. Itu memboroskan waktu sedikit,
                // tapi jauh lebih murah daripada kehilangan pekerjaan berjam-jam.
                //   137/139/140 = dibunuh OS / segfault, biasanya kehabisan RAM
                //   143         = dihentikan (SIGTERM)
                //   104/134/247 = batas memori terlampaui
                // Tunggu sebelum mencoba lagi, makin lama tiap percobaan:
                // 1 menit, 2, 4, 5, 5 -> total sabar ~17 menit.
                //
                // Perlu jeda karena pada 25 Sep 2026 node mati 13 menit
                // (slurmd tumbang setelah kernel naik dan modul NVIDIA hilang).
                // Retry tanpa jeda habis dalam hitungan detik lalu menyerah,
                // sehingga pipeline tetap mati walau job sudah di-requeue Slurm.
                // exitStatus null = job dibunuh dari LUAR (node jatuh, scancel,
                // slurmd tumbang). Nextflow tidak punya kode keluar untuk kasus
                // ini, jadi null WAJIB ikut diulang. Tanpa ini, 4 task HARMONIZE
                // angelo mati tanpa dicoba lagi pada 25 Sep 2026.
                def kode = task.exitStatus
                if ((kode == null || kode in [1,104,134,137,139,140,143,247])
                        && task.attempt <= 5) {
                    sleep(Math.min(300000L, (long)(Math.pow(2, task.attempt) * 30000)))
                    return 'retry'
                }
                return 'finish'
            }
            maxRetries    = 5
        }

        process {
            // Menaikkan jatah METAFLYE dari 16 CPU/64 GB (bawaan nextflow.config).
            // Alasan: minimap2 di dalam flye dipanggil dengan -I 64G, mustahil
            // muat di pagu 64 GB - itu sebabnya assembly mati exit 139 (segfault)
            // setelah 4 jam pada 24 Sep 2026.
            //
            // 'conda' WAJIB ditulis ulang di sini. Selector withName dari file
            // yang di-include belakangan MENIMPA seluruh blok selector, bukan
            // menggabung per-direktif. Tanpa baris ini, envs/assembly.yml tidak
            // diaktifkan dan flye tidak ditemukan (exit 127).
            // GTDB-Tk: pplacer butuh memori jauh lebih besar dari 96 GB yang
            // dipasang modulnya. Tiga percobaan pada 25 Sep 2026 semuanya mati
            // OUT_OF_MEMORY di 96 GB (32, 39 menit) dengan PplacerException,
            // karena pohon referensi GTDB penuh dimuat ke RAM.
            //
            // 'conda' WAJIB ditulis ulang di sini. Selector withName dari file
            // yang di-include belakangan MENIMPA seluruh blok selector, bukan
            // menggabung per-direktif - kalau baris ini hilang, envs/taxonomy.yml
            // tidak diaktifkan dan gtdbtk tidak ditemukan (exit 127).
            withName: 'GTDBTK_CLASSIFY' {
                cpus   = 16
                memory = { 340.GB * task.attempt }
                time   = '3d'
                conda  = "${projectDir}/envs/taxonomy.yml"
            }

            withName: 'METAFLYE' {
                cpus   = 96
                memory = '376 GB'
                time   = '5d'
                conda  = "${projectDir}/envs/assembly.yml"
            }
        }

executor {
            name            = 'slurm'
            queueSize = 2       // QoS besar izinkan 2 job per pengguna
            submitRateLimit = '10/1min'
            pollInterval    = '30 sec'
        }

        // Conda bersama - terlihat dari dev-bioinfo maupun node komputasi
        conda {
            enabled  = true
            useMamba = true
            cacheDir = '/media/bio-pool/software/conda-envs'
        }
    
        // Laporan: paksa tulis-ulang. Tanpa overwrite, berkas lama
        // menghalangi penulisan dan run berakhir rc=1 di langkah terakhir
        // walau seluruh pekerjaannya sudah selesai (kejadian pada angelo,
        // pipeline_trace.txt tertinggal dari 10 Sep 2026).
        trace    { overwrite = true }
        report   { overwrite = true }
        timeline { overwrite = true }
        dag      { overwrite = true }
}
}

