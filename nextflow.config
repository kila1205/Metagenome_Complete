process {

    executor = 'local'


    /*
    ====================================================
    QC
    ====================================================
    */

    withName: RAW_NANOPLOT {
        cpus   = 8
        memory = '16 GB'
        time   = '8h'
        conda  = "${projectDir}/envs/qc.yml"
    }

    withName: FILTLONG {
        cpus   = 8
        memory = '16 GB'
        time   = '8h'
        conda  = "${projectDir}/envs/qc.yml"
    }

    withName: FILTERED_NANOPLOT {
        cpus   = 8
        memory = '16 GB'
        time   = '8h'
        conda  = "${projectDir}/envs/qc.yml"
    }

    withName: MULTIQC {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
        conda  = "${projectDir}/envs/qc.yml"
    }


    /*
    ====================================================
    READ-BASED TAXONOMY
    ====================================================
    */

    withName: KRAKEN2_CLASSIFY {
        cpus   = 16
        memory = '64 GB'
        time   = '24h'
        conda  = "${projectDir}/envs/read_taxonomy.yml"
    }

    withName: BRACKEN_ABUNDANCE {
        cpus   = 4
        memory = '16 GB'
        time   = '6h'
        conda  = "${projectDir}/envs/read_taxonomy.yml"
    }


    /*
    ====================================================
    ASSEMBLY
    ====================================================
    */

    withName: METAFLYE {
        cpus   = 16
        memory = '64 GB'
        time   = '24h'
        conda  = "${projectDir}/envs/assembly.yml"
    }

    withName: ASSEMBLY_STATS {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
        conda  = "${projectDir}/envs/assembly.yml"
    }

    withName: QUAST {
        cpus   = 8
        memory = '32 GB'
        time   = '8h'
        conda  = "${projectDir}/envs/assembly.yml"
    }


    /*
    ====================================================
    GENE PREDICTION
    ====================================================
    */

    withName: PRODIGAL {
        cpus   = 4
        memory = '16 GB'
        time   = '8h'
        conda  = "${projectDir}/envs/gene_prediction.yml"
    }

    withName: PROTEIN_STATS {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
        conda  = "${projectDir}/envs/gene_prediction.yml"
    }


    /*
    ====================================================
    PROTEIN CLUSTERING
    ====================================================
    */

    withName: COMBINE_PROTEINS {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
        conda  = "${projectDir}/envs/clustering.yml"
    }

    withName: MMSEQS_CLUSTER {
        cpus   = 16
        memory = '64 GB'
        time   = '24h'
        conda  = "${projectDir}/envs/clustering.yml"
    }

    withName: CATALOG_STATS {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
        conda  = "${projectDir}/envs/clustering.yml"
    }


    /*
    ====================================================
    FUNCTIONAL PREDICTION
    ====================================================
    */

    withName: KOFAMSCAN {
        cpus   = 16
        memory = '64 GB'
        time   = '48h'
        conda  = "${projectDir}/envs/kofamscan.yml"
    }


    /*
    ====================================================
    LARGE-SCALE FUNCTIONAL ANNOTATION
    ====================================================
    */

    withName: EGGNOG_MAPPER {
        cpus   = 16
        memory = '64 GB'
        time   = '48h'
        conda  = "${projectDir}/envs/eggnog.yml"
    }


    /*
    ====================================================
    BINNING
    ====================================================
    */

    withName: MAP_READS {
        cpus   = 16
        memory = '64 GB'
        time   = '24h'
        conda  = "${projectDir}/envs/binning.yml"
    }

    withName: CONTIG_DEPTH {
        cpus   = 8
        memory = '32 GB'
        time   = '8h'
        conda  = "${projectDir}/envs/binning.yml"
    }

    withName: METABAT2 {
        cpus   = 16
        memory = '64 GB'
        time   = '12h'
        conda  = "${projectDir}/envs/binning.yml"
    }

    withName: BIN_STATS {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
        conda  = "${projectDir}/envs/binning.yml"
    }


    /*
    ====================================================
    ABUNDANCE
    ====================================================
    */

    withName: COVERM_ABUNDANCE {
        cpus   = 16
        memory = '64 GB'
        time   = '24h'
        conda  = "${projectDir}/envs/abundance.yml"
    }


    /*
    ====================================================
    GTDB-TK TAXONOMY
    ====================================================
    */

    withName: GTDBTK_CLASSIFY {
        cpus   = 16
        memory = '96 GB'
        time   = '48h'
        conda  = "${projectDir}/envs/taxonomy.yml"
    }

    withName: PARSE_TAXONOMY {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
        conda  = "${projectDir}/envs/taxonomy.yml"
    }


    /*
    ====================================================
    FINAL REPORT
    ====================================================
    */

    withName: GENERATE_REPORT {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
        conda  = "${projectDir}/envs/report.yml"
    }
}


/*
========================================================
 CONDA
========================================================
*/

conda {
    enabled = true
}


/*
========================================================
 PIPELINE MONITORING
========================================================
*/

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/dag.html"
}

// Profil Slurm - ditambahkan 2026-09-24
includeConfig 'conf/cluster.config'
